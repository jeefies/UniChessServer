            "description": "实战走出的单步 UCI 着法（如 f1c4）。"
          },
          "profile": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Profile",
            "description": "预设档位（lightning / fast / standard / deep / ultra）。",
            "default": "deep"
          },
          "limits": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MoveAnalysisLimits"
