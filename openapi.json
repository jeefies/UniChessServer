          "completedDepth",
          "engine",
          "stats"
        ],
        "title": "EvaluateResponse"
      },
      "GameMoveItem": {
        "properties": {
          "ply": {
            "type": "integer",
            "title": "Ply",
            "description": "半步序号（1-indexed）"
          },
          "move": {
            "type": "string",
            "title": "Move",
            "description": "实战 UCI 走法，如 e2e4"
          },
          "san": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "San",
            "description": "标准代数记谱法（SAN），如 e4, Nf3"
          },
          "turn": {
            "type": "string",
            "title": "Turn",
            "description": "行棋方 ('white' 或 'black')"
          },
          "bestMove": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bestmove",
            "description": "引擎计算的最佳着法"
          },
          "diffCp": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Diffcp",
            "description": "厘兵亏损值：0为最佳，负数表示相较最佳着法的损失（厘兵，100 cp = 1 兵）"
          },
          "diffWdlLoss": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Diffwdlloss",
            "description": "失败率增加值千分比"
          },
          "judgment": {
            "type": "string",
            "title": "Judgment",
            "description": "棋步评语：best(🌟最佳), excellent(👍优秀), good(🆗良好), inaccuracy(⚠️疑问手), mistake(❓失着), blunder(❌败着)"
          },
          "accuracy": {
            "type": "number",
            "title": "Accuracy",
            "description": "单步准确率百分比（0.0 ~ 100.0）"
          },
          "depth": {
            "type": "integer",
            "title": "Depth",
            "description": "实际共同完成深度"
          },
          "score": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ScoreDetail"
              },
              {
                "type": "null"
              }
            ],
            "description": "行棋方视角的局面评分"
          },
          "wdl": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/WdlDetail"
              },
              {
                "type": "null"
              }
            ],
            "description": "胜平负千分比概率"
          },
          "opening": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/OpeningInfo"
              },
              {
                "type": "null"
              }
            ],
            "description": "开局定式识别"
          },
          "cached": {
            "type": "boolean",
            "title": "Cached",
            "description": "是否命中持久化磁盘缓存",
            "default": false
          },
          "elapsedMs": {
            "type": "integer",
            "title": "Elapsedms",
            "description": "单步评估计算耗时（毫秒）"
          }
        },
